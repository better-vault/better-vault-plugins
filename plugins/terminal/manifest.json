{
  "manifestVersion": 2,
  "id": "terminal",
  "name": "Terminal",
  "version": "1.0.1",
  "description": "Reimagines better-vault as a terminal: monospaced type, square corners, dashed rules and phosphor-green accents, in light and dark mode.",
  "author": "better-vault",
  "icon": "code",
  "permissions": [],
  "tags": ["mod", "theme", "monospace", "retro"],
  "contributes": {
    "theme": {
      "light": {
        "background": "#f6f8f4",
        "foreground": "#14210f",
        "card": "#ffffff",
        "muted": "#e8ede4",
        "muted-foreground": "#4b5a44",
        "primary": "#1f7a2e",
        "primary-foreground": "#f6f8f4",
        "border": "#c9d4c1",
        "ring": "#1f7a2e"
      },
      "dark": {
        "background": "#070b07",
        "foreground": "#b8f5b0",
        "card": "#0c120c",
        "popover": "#0c120c",
        "muted": "#132013",
        "muted-foreground": "#6fa56a",
        "accent": "#173117",
        "primary": "#39ff5a",
        "primary-foreground": "#041004",
        "border": "#1f3a1f",
        "ring": "#39ff5a",
        "chart-1": "#b8f5b0"
      }
    },
    "mods": [{ "id": "terminal-layout", "title": "Monospaced, square, dashed", "file": "terminal.css" }]
  }
}
